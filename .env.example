VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# CARTO basemap tiles (public, restrict to kyts.ee in the CARTO key console).
# Free key: https://carto.com/basemaps/apikey — without it tiles are watermarked.
VITE_CARTO_KEY=your_carto_basemaps_key

# Server-side secrets (Vercel dashboard + local .env; never VITE_-prefixed).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GEMINI_API_KEY=your_gemini_api_key

# Market-insight cron (api/generate-market-insight.ts). Any random 32-byte
# string; Vercel Cron auto-sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change_me_to_a_random_string

# US Energy Information Administration API key for daily oil spot prices
# (Brent, ULSD diesel proxy, CARBOB gasoline). Free signup:
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key
